{
  "id": "/folio/",
  "name": "Folio",
  "short_name": "Folio",
  "description": "Pen-first study notes for medicine.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [".pdf"],
        "image/*": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".heic"],
        "audio/*": [".mp3", ".m4a", ".wav", ".ogg", ".aac"],
        "text/*": [".txt", ".md", ".csv", ".html", ".htm"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [".pptx"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
        "application/msword": [".doc"],
        "application/vnd.ms-powerpoint": [".ppt"],
        "application/vnd.ms-excel": [".xls"]
      }
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "files", "accept": ["*/*"] }
      ]
    }
  },
  "shortcuts": [
    { "name": "New note", "url": "./#/new", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ],
  "background_color": "#4a3023",
  "theme_color": "#4a3023",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
